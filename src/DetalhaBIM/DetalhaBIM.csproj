<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 roda sobre .NET 10 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite compilar também em Linux/macOS (CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DetalhaBIM</AssemblyName>
    <RootNamespace>DetalhaBIM</RootNamespace>
    <Version>1.1.1</Version>
    <Product>DetalhaBIM</Product>
    <Description>Automação de detalhamento arquitetônico para Autodesk Revit 2027</Description>
    <Copyright>DetalhaBIM</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <RevitVersion>2027</RevitVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies de referência da API do Revit 2027 (não são copiados para a saída) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DetalhaBIM.addin" />
    <None Include="Bundle\PackageContents.xml" />
  </ItemGroup>

  <!--
    Monta, na pasta de saída, o pacote no formato oficial da Autodesk:

      DetalhaBIM.bundle\
      ├── PackageContents.xml
      └── Contents\2027\
          ├── DetalhaBIM.addin
          └── DetalhaBIM.dll

    Instalação: copiar a pasta DetalhaBIM.bundle para %AppData%\Autodesk\ApplicationPlugins.
    Não é necessário executar scripts nem instaladores.
  -->
  <Target Name="MontarBundle" AfterTargets="Build" DependsOnTargets="AssinarDll">
    <PropertyGroup>
      <BundleDir>$(TargetDir)DetalhaBIM.bundle\</BundleDir>
      <BundleContents>$(BundleDir)Contents\$(RevitVersion)\</BundleContents>
    </PropertyGroup>
    <RemoveDir Directories="$(BundleDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Bundle\PackageContents.xml" DestinationFolder="$(BundleDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\DetalhaBIM.addin;$(TargetDir)DetalhaBIM.dll;$(TargetDir)DetalhaBIM.pdb" DestinationFolder="$(BundleContents)" />
    <Message Importance="high" Text="Pacote pronto: $(BundleDir)" />
  </Target>

  <!--
    Assinatura digital opcional (necessária para o Controle de Aplicativo Inteligente do Windows 11
    aceitar o plugin sem ser desligado). Requer um certificado de assinatura de código instalado
    e o signtool no PATH (Developer PowerShell do Visual Studio / Windows SDK):

      dotnet build -c Release -p:SignThumbprint=<impressão digital do certificado>
  -->
  <Target Name="AssinarDll" Condition="'$(SignThumbprint)' != '' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <SignTimestampUrl Condition="'$(SignTimestampUrl)' == ''">http://timestamp.digicert.com</SignTimestampUrl>
    </PropertyGroup>
    <Exec Command="signtool sign /fd SHA256 /td SHA256 /tr $(SignTimestampUrl) /sha1 $(SignThumbprint) &quot;$(TargetPath)&quot;" />
  </Target>

  <!--
    Em Windows, após compilar em Debug, instala o pacote em %AppData%\Autodesk\ApplicationPlugins
    (e remove a instalação antiga em Addins\2027, se existir, para não carregar duas vezes).
    Desative com: dotnet build -p:DeployToRevit=false
  -->
  <Target Name="DeployToRevit" AfterTargets="MontarBundle" Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Debug' And '$(DeployToRevit)' != 'false'">
    <PropertyGroup>
      <PluginsDir>$(AppData)\Autodesk\ApplicationPlugins\DetalhaBIM.bundle\</PluginsDir>
      <OldAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</OldAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <BundleFiles Include="$(TargetDir)DetalhaBIM.bundle\**\*" />
    </ItemGroup>
    <Delete Files="$(OldAddinsDir)DetalhaBIM.addin" ContinueOnError="true" />
    <RemoveDir Directories="$(OldAddinsDir)DetalhaBIM" ContinueOnError="true" />
    <Copy SourceFiles="@(BundleFiles)" DestinationFiles="@(BundleFiles->'$(PluginsDir)%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="true" />
    <Message Importance="high" Text="DetalhaBIM instalado em $(PluginsDir)" />
  </Target>

</Project>
