<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 roda sobre .NET 10 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Permite compilar também em Linux/macOS (CI) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DetalhaBIM</AssemblyName>
    <RootNamespace>DetalhaBIM</RootNamespace>
    <Version>1.1.3</Version>
    <Product>DetalhaBIM</Product>
    <Description>Automação de detalhamento arquitetônico para Autodesk Revit 2027</Description>
    <Copyright>DetalhaBIM</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <RevitVersion>2027</RevitVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies de referência da API do Revit 2027 (não são copiados para a saída) -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DetalhaBIM.addin" />
  </ItemGroup>

  <!--
    Monta, na pasta de saída, o pacote pronto para copiar para a pasta de add-ins do usuário
    (%AppData%\Autodesk\Revit\Addins\2027) — o único local que o Revit 2027 garante carregar
    para plugins sem assinatura digital:

      Pacote\
      ├── DetalhaBIM.addin
      └── DetalhaBIM.dll        (na mesma pasta do .addin)
  -->
  <Target Name="MontarPacote" AfterTargets="Build" DependsOnTargets="AssinarDll">
    <PropertyGroup>
      <PacoteDir>$(TargetDir)Pacote\</PacoteDir>
    </PropertyGroup>
    <RemoveDir Directories="$(PacoteDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\DetalhaBIM.addin" DestinationFolder="$(PacoteDir)" />
    <Copy SourceFiles="$(TargetDir)DetalhaBIM.dll" DestinationFolder="$(PacoteDir)" />
    <Message Importance="high" Text="Pacote pronto: $(PacoteDir)" />
  </Target>

  <!--
    Assinatura digital opcional (necessária para o Controle de Aplicativo Inteligente do Windows 11
    aceitar o plugin sem ser desligado). Requer um certificado de assinatura de código instalado
    e o signtool no PATH (Developer PowerShell do Visual Studio / Windows SDK):

      dotnet build -c Release -p:SignThumbprint=<impressão digital do certificado>
  -->
  <Target Name="AssinarDll" Condition="'$(SignThumbprint)' != '' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <SignTimestampUrl Condition="'$(SignTimestampUrl)' == ''">http://timestamp.digicert.com</SignTimestampUrl>
    </PropertyGroup>
    <Exec Command="signtool sign /fd SHA256 /td SHA256 /tr $(SignTimestampUrl) /sha1 $(SignThumbprint) &quot;$(TargetPath)&quot;" />
  </Target>

  <!--
    Em Windows, após compilar em Debug, instala em %AppData%\Autodesk\Revit\Addins\2027 e remove
    restos de versões anteriores (pasta DetalhaBIM em Addins\2027 e pacote .bundle em ApplicationPlugins).
    Desative com: dotnet build -p:DeployToRevit=false
  -->
  <Target Name="DeployToRevit" AfterTargets="MontarPacote" Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Debug' And '$(DeployToRevit)' != 'false'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <ItemGroup>
      <PacoteFiles Include="$(TargetDir)Pacote\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(AppData)\Autodesk\ApplicationPlugins\DetalhaBIM.bundle;$(RevitAddinsDir)DetalhaBIM" ContinueOnError="true" />
    <Copy SourceFiles="@(PacoteFiles)" DestinationFiles="@(PacoteFiles->'$(RevitAddinsDir)%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="true" />
    <Message Importance="high" Text="DetalhaBIM instalado em $(RevitAddinsDir)" />
  </Target>

</Project>
