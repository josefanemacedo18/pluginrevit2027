<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verificador de instalação: repete, sem o Revit, as checagens que o Revit 2027 faz ao carregar
    um add-in (lê o .addin, resolve o caminho da DLL, carrega os metadados e confere classes).
    Uso: dotnet run - -project tests/Verificador - - <pasta com DetalhaBIM.addin> [versão] [ToolCatalog.cs]
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RevitApiVersion>2027.0.0</RevitApiVersion>
    <WindowsDesktopRefVersion>10.0.12</WindowsDesktopRefVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.12" />
    <!-- Somente para ter os assemblies de referência disponíveis (não são usados na compilação). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiVersion)" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiVersion)" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[$(WindowsDesktopRefVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgNice3point_Revit_Api_RevitAPI)\ref\net10.0-windows7.0\*.dll" Link="refs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgNice3point_Revit_Api_RevitAPIUI)\ref\net10.0-windows7.0\*.dll" Link="refs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref\$(WindowsDesktopRefVersion)\ref\net10.0\*.dll" Link="refs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
